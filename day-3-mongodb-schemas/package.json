{
  "name": "day-3-mongodb-schemas",
  "version": "1.0.0",
  "private": true,
  "description": "Clinic appointment Patient and Appointment schemas with indexes",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/examples/createSampleData.js",
    "test": "jest --runInBand --runTestsByPath tests/schema.test.js",
    "test:integration": "jest --runInBand --runTestsByPath tests/integration.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 120000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
